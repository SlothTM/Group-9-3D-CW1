  m_Script: {fileID: 11500000, guid: 1ae465ec3d010df41ac7bdd3aa6c9a4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: {fileID: 1615618426}
  dialogue:
  - LOOK UP AT YOUR MASTER YOU FOOL I AM THE GREAT WIZARD OF THIS ISLAND
  - ' Despite all the warnings from the rumours you have heard you decided to come
    to Berry Island'
  - No one but me knows the great power ones mind holds i shall take your wasted
    potential and add it to my own
  - With that your mind is forever lost.
  - Like the others on this island youre trapped doomed to look for treasure that
    doesnt exist none the wiser to me.
  - MUHAHAHAHAAHAH! MUHAHAHAHAAHAH! MUHAHAHAHAAHAH! MUHAHAHAHAAHAH!
  textSpeed: 0.01
  game: {fileID: 330593427}
  timetowait: 1000
  index: 0
