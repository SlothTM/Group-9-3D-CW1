  m_Name: 
  m_EditorClassIdentifier: 
  text: {fileID: 1615618426}
  dialogue:
  - Who are you, folks round here call me anubis cant imagine why
  - Anyway i was gonna kill this little critter when i found him and keep all the
    treasure to myself
  - But he was just way too cute so i gave it all up, and now i give the next piece
    to you
  - On the hill that lies closest to the heavens below the tower that leads to hell
  - Your next clue is there but be careful i fear danger lies ahead
  textSpeed: 0.01
  game: {fileID: 330593427}
  timetowait: 1000
  index: 0
