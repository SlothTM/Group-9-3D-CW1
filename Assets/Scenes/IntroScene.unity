  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ae465ec3d010df41ac7bdd3aa6c9a4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: {fileID: 0}
  dialogue:
  - Ah you must be the young lad that arrived here, I like to ask how was your trip
    here, must have been rough ehh?
  - Had some stormy seas? Gyaa Ha ha ha! That the usual around here, the weather
    around here sometime isn't for the weak, I can say the same for this island.
  - "Eh? You looking for the mystery why some who had left the island went insane?
    I don\u2019t really know the whole truth but I can give a hint on a clue."
  - Here is a classic one, find the X that marks the spot. That should get you started.
  - Anyways young lad I hope your adventure goes well. Gyaa Ha ha ha!
  textSpeed: 0.01
  game: {fileID: 0}
  timetowait: 1000
  index: 0
