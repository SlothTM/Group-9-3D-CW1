  m_Name: 
  m_EditorClassIdentifier: 
  text: {fileID: 455253578}
  dialogue:
  - There was once a young lad that decided to explore Berry Island
  - He sought to uncover the rumours where some who returned from the island turned
    insane and later died
  - Although discouraged by his peers, his desire for truth and adventure pushed
    him to journey the seven seas and take the plunge
  - "Will he be able to uncover the truth or will he succumb to the same fate as
    those before\u2026"
  - Press SPACE to wake up
  textSpeed: 0.01
  game: {fileID: 0}
  timetowait: 10
  index: 0
